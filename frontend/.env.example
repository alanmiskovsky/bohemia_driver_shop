# WordPress API URL
# Local dev proxies to https://shop.bohemiadriver.cz via vite.config.js
# For production build, set the full URL if needed
VITE_WP_API_URL=/wp-json

# Stripe (for payments)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Zasilkovna (for shipping)
VITE_ZASILKOVNA_API_KEY=your_zasilkovna_api_key
